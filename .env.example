# Trend Quant 环境变量模板（P2-13）。复制为 .env 后填值；.env 永不入库，
# 本模板经 .gitignore 的 !.env.example 例外可提交。

# ── 必需 ─────────────────────────────────────────────
# TickFlow 实时报价密钥（盘中/实时功能依赖）
TICKFLOW_API_KEY=

# ── MCP 通道（机对机）─────────────────────────────────
# Bearer token → 用户名映射；不配则 /mcp 对所有请求 401（失败关闭）
TREND_MCP_TOKENS=tokenA=yyx
# DNS rebinding 保护（frp 域名，可带端口或 :* 通配）。
# 上线顺序：先验证 Bearer token 通过，再配置本项开启保护。
# TREND_MCP_ALLOWED_HOSTS=mcp.example.com:*

# ── 可选覆盖 ─────────────────────────────────────────
# 内置管理员 yyx 的引导密码（仅首次创建用户时生效；缺省见 README，首登后请改密）
# TREND_QUANT_BOOTSTRAP_ADMIN_PASSWORD=
# TickFlow 镜像站（默认 https://api.tickflow.org）
# TICKFLOW_BASE_URL=
# 报价缓存 TTL 秒数（默认 30）
# TICKFLOW_QUOTE_CACHE_TTL_SECONDS=30
# 禁用调度器（测试/调试用）
# TREND_QUANT_DISABLE_SCHEDULER=
# 日志目录覆盖（默认 <项目根>/logs/app）
# TREND_QUANT_LOG_DIR=
# 项目根覆盖（默认以代码位置锚定）
# TREND_QUANT_HOME=
